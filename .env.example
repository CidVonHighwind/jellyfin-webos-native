# Copy to .env (git-ignored). Used by `zig build deploy` / `run` / `install-app`.
WEBOS_HOST=10.10.8.63
WEBOS_USER=root
# Where `deploy` drops binaries for quick testing:
WEBOS_TMP=/tmp
# Where `install-app` puts the packaged app:
WEBOS_APPDIR=/media/developer/apps/usr/palm/applications

# Password for the TV's VNC server on 5900, used by `zig build shot`.
WEBOS_VNC_PASS=

# Jellyfin server. Only used to prefill the sign-in screen during development
# (and by `zig test src/jellyfin/api.zig`, which skips without them). The app
# discovers servers over UDP and stores an access token, never a password.
JELLYFIN_ADDRESS=
JELLYFIN_USER=
JELLYFIN_PASSWORD=

# Where the app keeps its token. Defaults to $HOME/.jellyfin-native.
JELLYFIN_STORE=

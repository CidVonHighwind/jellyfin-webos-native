# Copy to .env (git-ignored). Sourced by hand, not by the build.

# Which TV `ares-install` and `ares-launch` talk to, as named in `ares-setup-device`.
ARES_DEVICE=tv

# Password for the TV's VNC server on 5900, used by tools/vncshot.py.
WEBOS_VNC_PASS=

# Jellyfin server. Only used to prefill the sign-in screen during development.
# The app discovers servers over UDP and stores an access token.
JELLYFIN_ADDRESS=
JELLYFIN_USER=
JELLYFIN_PASSWORD=

# Where the app keeps its token. Defaults to the installed app's own directory,
# or /tmp/jellyfin-native when run any other way.
JELLYFIN_STORE=

# Copy to .env (git-ignored). Used by `zig build deploy` / `run` / `install-app`.
WEBOS_HOST=10.10.8.63
WEBOS_USER=root
# Where `deploy` drops binaries for quick testing:
WEBOS_TMP=/tmp
# Where `install-app` puts the packaged app:
WEBOS_APPDIR=/media/developer/apps/usr/palm/applications

# Password for the TV's VNC server on 5900, used by `zig build shot`.
WEBOS_VNC_PASS=

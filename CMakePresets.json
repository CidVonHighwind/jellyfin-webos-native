{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "webos",
      "displayName": "webOS TV (arm)",
      "description": "Cross build with the openlgtv buildroot NDK. Set WEBOS_SDK to move it off /opt.",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/webos-toolchain.cmake",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host",
      "displayName": "This machine",
      "description": "Backend-agnostic code and its tests.",
      "binaryDir": "${sourceDir}/build-host",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-Wall -Wextra -Werror -fsanitize=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror -fsanitize=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows (MSYS2 UCRT64)",
      "description": "Local UI-debugging build. GLES comes from ANGLE; no UBSan, which mingw-w64 does not ship.",
      "binaryDir": "${sourceDir}/build-windows",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-Wall -Wextra",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "webos",
      "configurePreset": "webos"
    },
    {
      "name": "host",
      "configurePreset": "host"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
